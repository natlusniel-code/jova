# Copy to .env.local and fill in the values.
#
# ── SECURITY ────────────────────────────────────────────────────────────────
# This file lists NAMES ONLY. Never put a real secret in a file that is
# committed. The real values must be set in the DEPLOYMENT ENVIRONMENT
# (Vercel → Project Settings → Environment Variables, for Production and
# Preview) and, for local development, in `.env.local` — which is gitignored.
#
# There are NO committed fallbacks for the secrets below. If a variable is
# missing the app fails loudly instead of using a key that is already in the
# repository:
#   * SUPABASE_SERVICE_ROLE_KEY missing → admin console shows "not configured",
#     every admin action returns an error, and Firebase sign-in cannot create a
#     marketplace account (see the note on the Firebase bridge below).
#   * NEXT_PUBLIC_FIREBASE_* missing → the sign-in panel reports that sign-in
#     is not configured, instead of failing with a blank error.
#   * JOBS_SECRET missing              → /api/jobs/run answers 503.
#
# See README §1d for the full list and where each value comes from.

# ── Public (browser-exposed) ─────────────────────────────────────────────────
# These are public by design: the anon key is what every browser gets, and RLS
# is what protects the data. `src/lib/supabase/config.ts` carries the same
# values as a literal fallback so the app builds on a host with no variables.
NEXT_PUBLIC_SUPABASE_URL=https://ecejkevdfpzfvwfjjqwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nTmbEq4kh7viHqVFiSxtmw_m7Yh5-QI

# Public base URL of this app. Used for absolute links in emails and for the
# Firebase OAuth redirect domain allow-list. Must match the domains authorised
# in Firebase Console → Authentication → Settings → Authorized domains, or the
# OAuth round trip is rejected. See README §1c.
NEXT_PUBLIC_SITE_URL=https://naijamart-marketplace-opal.vercel.app
# Optional alias for the same value.
NEXT_PUBLIC_APP_URL=

# ── Firebase (identity provider) ─────────────────────────────────────────────
# Firebase is the only auth provider: Google, Apple, LinkedIn and email +
# password. There is no Clerk in this app any more — the `@clerk/nextjs`
# dependency and every Clerk route were removed, because a leftover Clerk page
# (`/auth/sso-callback`) called `useClerk` with no `<ClerkProvider />` mounted
# and broke the production build at the prerender step.
#
# These values are PUBLIC by design: they identify the Firebase project to the
# browser SDK. They authorise nothing on their own — Firebase Security Rules
# and the server-side ID-token verification are what protect the data.
# Get them from Firebase Console → Project settings → Your apps → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account, used to verify ID tokens.
# Either the three fields below, or a single JSON blob in
# FIREBASE_SERVICE_ACCOUNT_JSON. NEVER prefix any of these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The OAuth redirect domains are configured in the Firebase Console (not here):
#   Authentication → Settings → Authorized domains
# Add your production domain and every preview domain you sign in from.
# `signInWithRedirect` returns to `/auth`, which finishes the sign-in with
# `getRedirectResult()` — there is no separate callback route.

# ── Server-only secrets — REQUIRED, no fallback ─────────────────────────────
# NEVER prefix any of these with NEXT_PUBLIC_: that inlines them into the
# browser bundle.

# Supabase service-role key. Bypasses RLS; the admin console and the push
# dispatcher use it, and so does the Firebase→Supabase bridge
# (`src/lib/firebase/bridge.ts`), which has to look up and create marketplace
# users by verified email. Get it from
# Supabase → Project Settings → API Keys (the `service_role` secret, or a
# `sb_secret_…` key).
# ROTATE THIS if it has ever been committed, pasted into a chat, a log or a
# screenshot. Removing it from the repo does not make the old value dead.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID).
# The PUBLIC half is committed in src/lib/push-public.ts on purpose: it is not
# a secret (every subscribing browser receives it) and keeping it fixed is what
# lets existing subscriptions keep working without re-subscribing.
#
# The PRIVATE half is a secret and is NOT in the repository. Set it here and in
# the deployment environment. It must be the private half of the public key in
# src/lib/push-public.ts, or the push service rejects every send with 403.
# If it is missing, Web Push reports itself unconfigured and sends nothing.
VAPID_PRIVATE_KEY=
# Optional. A mailto: or https: URL identifying the sender to the push service.
VAPID_SUBJECT=mailto:support@naijamart.ng

# Shared secret that protects POST/GET /api/jobs/run (order timers + push
# flush). Generate a long random value, e.g.:
#   openssl rand -hex 32
# The same value must be configured on whatever calls the endpoint (Vercel
# Cron uses its own `x-vercel-cron` marker and needs no secret).
JOBS_SECRET=

# Google Gemini API key for the AI listing assistant and the admin copilot.
# Get it from Google Cloud console → APIs & Services → Credentials.
# ROTATE THIS if the old `NEXT_PUBLIC_GEMINI_KEY` was ever committed — it was,
# and it shipped in the client bundle.
GEMINI_API_KEY=

# ── Transactional email ──────────────────────────────────────────────────────
# NOTHING TO CONFIGURE HERE. Sign-in emails (verification links and password
# resets) are sent by Firebase Authentication, not by this app. There is no
# RESEND_API_KEY and no EMAIL_FROM in the code path any more.
#
# The sender name, the mail template and the custom sending domain are all
# configured in the Firebase Console:
#   Authentication → Templates  (sender name, body, reply-to)
#   Authentication → Templates → SMTP settings  (custom domain, needs a plan)
# That is a dashboard step, not an environment variable, so there is nothing to
# add here — see README §1c.


# WhatsApp OTP delivery (server-side only; never prefix these with NEXT_PUBLIC_)
WAAPI_API_KEY=
WAAPI_INSTANCE_ID=
# Generate a unique random secret, e.g. openssl rand -hex 32
WHATSAPP_OTP_SECRET=


# Firebase Admin SDK service account JSON (server-only; never prefix with NEXT_PUBLIC_)
# Paste the complete JSON value from Firebase Console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=
