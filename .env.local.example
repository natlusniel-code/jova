# Copy to .env.local and fill in the values.
#
# ── SECURITY ────────────────────────────────────────────────────────────────
# This file lists NAMES ONLY. Never put a real secret in a file that is
# committed. The real values must be set in the DEPLOYMENT ENVIRONMENT
# (Vercel → Project Settings → Environment Variables, for Production and
# Preview) and, for local development, in `.env.local` — which is gitignored.
#
# There are NO committed fallbacks for the secrets below any more. If a
# variable is missing the app fails loudly instead of using a key that is
# already in the repository:
#   * SUPABASE_SERVICE_ROLE_KEY missing → admin console shows "not configured"
#     and every admin action returns an error.
#   * VAPID_PRIVATE_KEY missing        → Web Push reports itself unconfigured.
#   * JOBS_SECRET missing              → /api/jobs/run answers 503.
#
# See README §1d for the full list and where each value comes from.

# ── Public (browser-exposed) ────────────────────────────────────────────────
# These are public by design: the anon key is what every browser gets, and RLS
# is what protects the data. `src/lib/supabase/config.ts` carries the same
# values as a literal fallback so the app builds on a host with no variables.
NEXT_PUBLIC_SUPABASE_URL=https://ecejkevdfpzfvwfjjqwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nTmbEq4kh7viHqVFiSxtmw_m7Yh5-QI

# Public base URL of this app, used for OAuth + email verification redirects.
# Must match Supabase Auth → site_url / uri_allow_list, or confirmation links
# will bounce to the wrong origin. See README §1c.
NEXT_PUBLIC_SITE_URL=https://naijamart-marketplace-opal.vercel.app

# ── Server-only secrets — REQUIRED, no fallback ─────────────────────────────
# NEVER prefix any of these with NEXT_PUBLIC_: that inlines them into the
# browser bundle.

# Supabase service-role key. Bypasses RLS; the admin console and the push
# dispatcher use it. Get it from Supabase → Project Settings → API Keys
# (the `service_role` secret, or a `sb_secret_…` key).
# ROTATE THIS if it has ever been committed, pasted into a chat, a log or a
# screenshot. Removing it from the repo does not make the old value dead.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) key pair. Generate with:
#   npx web-push generate-vapid-keys
# The PRIVATE key signs pushes; the PUBLIC key is handed to every browser that
# subscribes (so it is safe to expose, but it must match the private key).
# Rotating the pair invalidates existing subscriptions; devices re-subscribe on
# next page load.
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional. A mailto: or https: URL identifying the sender to the push service.
VAPID_SUBJECT=mailto:support@naijamart.ng

# Shared secret that protects POST/GET /api/jobs/run (order timers + push
# flush). Generate a long random value, e.g.:
#   openssl rand -hex 32
# The same value must be configured on whatever calls the endpoint (Vercel
# Cron uses its own `x-vercel-cron` marker and needs no secret).
JOBS_SECRET=

# Google Gemini API key for the AI listing assistant and the admin copilot.
# Get it from Google Cloud console → APIs & Services → Credentials.
# ROTATE THIS if the old `NEXT_PUBLIC_GEMINI_KEY` was ever committed — it was,
# and it shipped in the client bundle.
GEMINI_API_KEY=

# ── Transactional email ────────────────────────────────────────────────────
# There is NO email provider variable. Signup uses `supabase.auth.signUp()` and
# Supabase's own auth mailer sends the confirmation email — the app never talks
# to Resend or SendGrid. Configure delivery in the Supabase dashboard instead:
#   Authentication → Emails → SMTP Settings (custom SMTP, optional)
#   Authentication → Emails → Confirm signup (template)
# See README §1e.
